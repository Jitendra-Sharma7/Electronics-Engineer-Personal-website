rules_version = '2';

// ===========================================================================
// Firestore security rules — project jitendra-sharma-portfoli-945d6
//
// Documents live in a single "portfolioData" collection:
//   experienceItems.items    Skills / career timeline      (admin)
//   skillPillars.pillars     Skills Ecosystem pillars       (admin)
//   certifications.items     Certifications                 (admin)
//   educationItems.items     Education                      (admin)
//   blogItems.items          Blog articles                  (admin)
//   learningCourses.courses  Learning Hub topics            (admin)
//   projectsList.projects    Projects & case studies        (admin)
//   siteProfile              Hero / about / contact text   (admin)
//   contactMessages.messages Visitor inquiries              (public form)
//
// SECURITY MODEL
//   * Public visitors only READ. The public site must render every section,
//     so read access is deliberately public.
//   * Writes require a signed-in Firebase Authentication session belonging to
//     the administrator account. The browser cannot fake this: Firestore
//     evaluates the rule server-side using the verified ID token, so editing
//     admin.js or calling the REST API directly grants nothing.
//   * contactMessages stays publicly writable because the contact form posts
//     without a session. The public client appends with arrayUnion, so a
//     hostile client can add spam but cannot overwrite or truncate the inbox.
//
// To change the administrator address: create the new Firebase Auth user, edit
// ADMIN_EMAIL below, then publish these rules again.
//
// DEPLOY: Firebase Console > Firestore Database > Rules > paste > Publish.
// Nothing in this repository deploys rules automatically.
// ===========================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'jitendra.route2uni@gmail.com';
    }

    match /portfolioData/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitor inquiries from the public contact form (append-only by design).
    match /portfolioData/contactMessages {
      allow read: if true;
      allow write: if true;
    }

  }
}